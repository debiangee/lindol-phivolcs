# Server
PORT=3000
ENV=development

# USGS polling (seconds)
USGS_POLL_INTERVAL_SEC=120
MIN_MAGNITUDE=2.5

# PHIVOLCS primary mode (set to true on hosted/EC2 instance)
PHIVOLCS_PRIMARY=false
PHIVOLCS_POLL_INTERVAL_SEC=300

# PHIVOLCS enrichment (on-demand, triggered after USGS detection)
PHIVOLCS_DELAY_SEC=180
PHIVOLCS_MATCH_TIME_WINDOW_MIN=15
PHIVOLCS_MATCH_DISTANCE_DEG=0.5

# Philippine region bounding box
REGION_MIN_LAT=4.5
REGION_MAX_LAT=21.5
REGION_MIN_LON=116.0
REGION_MAX_LON=128.0

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional)
DISCORD_WEBHOOK_URL=

# Generic webhook (optional)
WEBHOOK_URL=
